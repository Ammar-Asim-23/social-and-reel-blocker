{
  "name": "unscroll",
  "private": true,
  "description": "Private, on-device short-video blocking and focus routines.",
  "license": "0BSD",
  "version": "1.0.0",
  "main": "index.ts",
  "expo": {
    "autolinking": {
      "nativeModulesDir": "./modules"
    }
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check:native": "node scripts/check-native-module.cjs",
    "eas-build-post-install": "node scripts/check-native-module.cjs",
    "prebuild": "expo prebuild",
    "export:web": "expo export --platform web"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~55.0.31",
    "expo-dev-client": "~55.0.40",
    "expo-local-authentication": "~55.0.18",
    "expo-modules-core": "~55.0.26",
    "expo-secure-store": "~55.0.18",
    "expo-status-bar": "~55.0.6",
    "lucide-react-native": "^1.55.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-svg": "15.15.3",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "~19.2.2",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.9.2"
  }
}
